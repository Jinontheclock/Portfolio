{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/site/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Spoqa Han Sans Neo))/i]",
        "message": "Font not provided by the design system. Available: Spoqa Han Sans Neo."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|size|arrowSrc|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ArrowLink> doesn't accept that prop. Declared props: label, children, size, arrowSrc, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangSwitcher'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|direction|style|key|ref|className|style|children)$/]",
        "message": "<LangSwitcher> doesn't accept that prop. Declared props: value, onChange, direction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangSwitcher'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:en|ja|ko)$/]",
        "message": "<LangSwitcher> value must be one of 'en' | 'ja' | 'ko'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangSwitcher'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:column|row)$/]",
        "message": "<LangSwitcher> direction must be one of 'column' | 'row'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaList'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|items|gap|style|key|ref|className|style|children)$/]",
        "message": "<MetaList> doesn't accept that prop. Declared props: label, items, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|href|size|muted|onClick|style|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: label, children, href, size, muted, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<PillButton> doesn't accept that prop. Declared props: label, children, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|onThemeChange|lang|onLangChange|year|markSrc|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: theme, onThemeChange, lang, onLangChange, year, markSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SiteFooter> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:en|ja|ko)$/]",
        "message": "<SiteFooter> lang must be one of 'en' | 'ja' | 'ko'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onNavigate|wordmark|style|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: active, onNavigate, wordmark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:work|about|none)$/]",
        "message": "<SiteHeader> active must be one of 'work' | 'about' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<ThemeToggle> doesn't accept that prop. Declared props: value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ThemeToggle> value must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|roles|imageSrc|imageHeight|onClick|style|key|ref|className|style|children)$/]",
        "message": "<WorkCard> doesn't accept that prop. Declared props: title, description, roles, imageSrc, imageHeight, onClick, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
